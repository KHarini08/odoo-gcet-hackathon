<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_stocksense_operation_tree" model="ir.ui.view">
        <field name="name">stocksense.operation.tree</field>
        <field name="model">stocksense.operation</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
                <field name="operation_type"/>
                <field name="product_id"/>
                <field name="quantity"/>
                <field name="status"/>
            </tree>
        </field>
    </record>

    <record id="view_stocksense_operation_form" model="ir.ui.view">
        <field name="name">stocksense.operation.form</field>
        <field name="model">stocksense.operation</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <field name="status" widget="statusbar"/>
                </header>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="operation_type"/>
                        <field name="product_id"/>
                        <field name="quantity"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_stocksense_operation" model="ir.actions.act_window">
        <field name="name">Operations</field>
        <field name="res_model">stocksense.operation</field>
        <field name="view_mode">tree,form</field>
    </record>

    <menuitem id="menu_stocksense_operations" name="Operations" parent="menu_stocksense_root" action="action_stocksense_operation" sequence="20"/>
</odoo>
