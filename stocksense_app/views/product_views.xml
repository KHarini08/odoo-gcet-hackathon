<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_stocksense_product_tree" model="ir.ui.view">
        <field name="name">stocksense.product.tree</field>
        <field name="model">stocksense.product</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
                <field name="sku_code"/>
                <field name="category"/>
                <field name="stock_quantity"/>
            </tree>
        </field>
    </record>

    <record id="view_stocksense_product_form" model="ir.ui.view">
        <field name="name">stocksense.product.form</field>
        <field name="model">stocksense.product</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="sku_code"/>
                        <field name="category"/>
                        <field name="uom"/>
                        <field name="stock_quantity"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_stocksense_product" model="ir.actions.act_window">
        <field name="name">Products</field>
        <field name="res_model">stocksense.product</field>
        <field name="view_mode">tree,form</field>
    </record>

    <menuitem id="menu_stocksense_products" name="Products" parent="menu_stocksense_root" action="action_stocksense_product" sequence="10"/>
</odoo>
